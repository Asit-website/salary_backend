# Copy to .env and adjust
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_DAYS=30

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thinktech_attendance
DB_USER=root
DB_PASSWORD=

# CORS (comma-separated allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# Local dev: keep false so restart does not run ZKTeco / SMS / attendance crons
ENABLE_BACKGROUND_JOBS=false
# DISABLE_BACKGROUND_JOBS=true

# OTP (DEV only — never enable in production)
OTP_DEV_CODE=
OTP_USE_FIXED=false
OTP_TTL_MS=300000
OTP_INCLUDE_IN_RESPONSE=false

# If set, superadmin user will be created on first boot if none exists
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Optional: auto-create one sample staff on boot for testing
SAMPLE_STAFF_ID=
SAMPLE_STAFF_PHONE=
SAMPLE_STAFF_NAME=
SAMPLE_STAFF_EMAIL=
SAMPLE_STAFF_PASSWORD=

# Cashfree Payout Credentials
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_PUBLIC_KEY=

# Cashfree Payment Gateway Credentials (for Top Up Link)
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=

# Mock payment routes (dev only — must be false in production)
ALLOW_MOCK_PAYMENTS=false

# eSSL biometric webhook secret (required in production)
ESSL_WEBHOOK_SECRET=

# Database field encryption key (32+ chars, required in production)
DATABASE_ENCRYPTION_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
